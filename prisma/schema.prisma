// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   
  name      String?  @db.VarChar(255)
  photoUrl  String?
  role      Role     @default(ADMIN)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  gecko         Gecko[]
  reviews       Reviews[]
  transactions  Transactions[]
}

model Gecko {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  harga     Int
  status    Status   @default(AVAILABLE)
  imageUrl  String?
  deskripsi String?  @db.VarChar(1000)
  published Boolean  @default(false)
  
  morph     String?  @db.VarChar(255)
  sire      String?  @db.VarChar(255)
  line      String?  @db.VarChar(255)
  dam       String?  @db.VarChar(255)
  dob       DateTime?
  weight    Int?
  gender    Gender?
  
  author    User?     @relation(fields: [authorId], references: [id])
  authorId  String?

  transactionItems   TransactionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id        Int     @id @default(1)
  name      String  @db.VarChar(100)
  deskripsi String
  visi      String
  misi      String?
  logo      String

  alamat    String

  email     String  @unique
  whatsapp  String  @db.VarChar(50)

  instagram String
  tiktok    String
}

model Reviews {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  message     String
  photo       String?
  published   Boolean  @default(false)

  author      User?    @relation(fields: [authorId], references: [id])
  authorId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transactions {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)     
  telp        String   @db.VarChar(20)

  author      User?    @relation(fields: [authorId], references: [id])
  authorId    String?

  items       TransactionItem[]

  createdAt   DateTime @default(now())
}

model TransactionItem {
  id            String   @id @default(cuid())
  
  transaction   Transactions @relation(fields: [transactionId], references: [id])
  transactionId String
  
  gecko         Gecko @relation(fields: [geckoId], references: [id])
  geckoId       String

  soldPrice     Int

  @@unique([transactionId, geckoId])
}


enum Role {
  SUPERADMIN
  ADMIN
}

enum Status {
  AVAILABLE
  SOLD
}

enum Gender {
  JANTAN
  BETINA
}